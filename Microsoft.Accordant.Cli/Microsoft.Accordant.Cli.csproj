<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <OutputPath>../bin/tools/Microsoft.Accordant.Cli</OutputPath>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Microsoft.Accordant</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>accordant</ToolCommandName>
    <PackageId>Microsoft.Accordant.Cli</PackageId>
    <PackageReadmeFile>docs\readme.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <Description>CLI tool for scaffolding Accordant model-based testing projects</Description>
    <PackageTags>accordant cli scaffolding testing model-based</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <!-- Embed templates and skills as resources -->
  <ItemGroup>
    <EmbeddedResource Include="Templates\**\*" />
    <!-- Skills now live in agent/skills/ at repo root; link them as embedded resources -->
    <EmbeddedResource Include="..\agent\skills\**\*" Link="Skills\%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- Exclude skill examples from compilation (they're just for reference) -->
    <Compile Remove="..\agent\skills\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\nuget\README.md" Pack="true" PackagePath="docs\readme.md" />
    <None Include="..\nuget\icon.png" Pack="true" PackagePath="icon.png" />
  </ItemGroup>

</Project>
