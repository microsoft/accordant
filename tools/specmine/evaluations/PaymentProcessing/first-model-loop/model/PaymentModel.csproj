<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Buildable .NET project for the Payment black-box investigation's partial
         Accordant model (successful-key AuthorizePayment idempotency region). -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>PaymentModel</RootNamespace>
    <AssemblyName>PaymentModel</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Accordant/Specmine SDK assemblies staged for this investigation, per the
         workspace's SDK boundary (sdk\*.dll). -->
    <Reference Include="Accordant">
      <HintPath>..\sdk\Accordant.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Accordant.Invariant">
      <HintPath>..\sdk\Accordant.Invariant.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Accordant.Operations">
      <HintPath>..\sdk\Accordant.Operations.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Specmine">
      <HintPath>..\sdk\Specmine.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Specmine.Accordant">
      <HintPath>..\sdk\Specmine.Accordant.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- [State]-attributed classes rely on Accordant's source generator to implement
         IState (Clone/Freeze/GetStateHash/StringRepresentation). -->
    <Analyzer Include="..\sdk\Accordant.SourceGenerator.dll" />
  </ItemGroup>

  <ItemGroup>
    <!-- Accordant.dll (netstandard2.0) depends on System.IO.Hashing for state hashing;
         it is not part of the shared framework, so it must be restored explicitly. -->
    <PackageReference Include="System.IO.Hashing" Version="9.0.7" />
  </ItemGroup>

</Project>