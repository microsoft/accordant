<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The one durable, live, model-driven Payment conformance test promoted after M-002 was
         accepted. See ..\README.md for the promotion rationale and ..\..\journal.md /
         ..\..\frontier.md for the durable record. -->
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>PaymentConformance.Tests</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- The durable partial model this test uses as its sole behavioral oracle. -->
    <ProjectReference Include="..\..\model\PaymentModel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Same SDK assemblies the model project references (sdk\*.dll). Accordant.Operations
         must be referenced directly (not just transitively via PaymentModel.csproj) because
         this project's own code names Spec&lt;TState&gt; and related types directly. -->
    <Reference Include="Accordant">
      <HintPath>..\..\sdk\Accordant.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Accordant.Operations">
      <HintPath>..\..\sdk\Accordant.Operations.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Specmine">
      <HintPath>..\..\sdk\Specmine.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Specmine.Accordant">
      <HintPath>..\..\sdk\Specmine.Accordant.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Specmine.Adapters.OpenApi">
      <HintPath>..\..\sdk\Specmine.Adapters.OpenApi.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- Accordant.dll (netstandard2.0) depends on System.IO.Hashing for state hashing; version
         pinned to match model\PaymentModel.csproj. -->
    <PackageReference Include="System.IO.Hashing" Version="9.0.7" />

    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.0" />
    <PackageReference Include="NUnit" Version="4.3.2" />
    <PackageReference Include="NUnit3TestAdapter" Version="5.0.0" />
    <PackageReference Include="NUnit.Analyzers" Version="4.7.0" />
  </ItemGroup>

</Project>
